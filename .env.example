# Supabase (service-role key is server-only; VITE values are public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin used for QR verification and secure ticket links
APP_BASE_URL=https://your-domain.example

# Server-side merchant references used on orders (public display uses matching VITE_ values)
MTN_MERCHANT_CODE=
MTN_MERCHANT_NAME=BUZZKET EVENTS
AIRTEL_MERCHANT_CODE=
AIRTEL_MERCHANT_NAME=BUZZKET EVENTS
VITE_MTN_MERCHANT_CODE=
VITE_MTN_MERCHANT_NAME=BUZZKET EVENTS
VITE_AIRTEL_MERCHANT_CODE=
VITE_AIRTEL_MERCHANT_NAME=BUZZKET EVENTS

# Twilio credentials are server-only. WhatsApp sender format: whatsapp:+<number>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved Twilio WhatsApp Content Template SID; template variables are 1=name, 2=event, 3=secure link, 4=ticket number
TWILIO_WHATSAPP_CONTENT_SID=

# Existing optional notification providers
RESEND_API_KEY=
TICKET_EMAIL_FROM=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
